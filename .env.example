# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=socialdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=abc123

# URL JDBC usada pelo backend para conectar ao banco (dentro do Docker usa "db" como host)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/socialdb

# ─── Backend ──────────────────────────────────────────────────────────────────
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Origins permitidas pelo CORS (separadas por vírgula, sem espaços)
# Local dev:      http://localhost:3000,http://localhost:6003
# Coolify/prod:   https://seu-dominio.com
CORS_ALLOWED_ORIGINS=http://localhost:6003

# ─── Frontend ─────────────────────────────────────────────────────────────────
# URL interna que o Next.js usa para fazer proxy das chamadas /api/*
# Em Docker:      http://backend:8080
# Dev sem Docker: http://localhost:8080
NEXT_PUBLIC_API_URL=http://backend:8080

# ─── Portas do host (somente para rodar local via docker compose) ──────────────
# No Coolify essas variáveis geralmente não são necessárias — o Coolify gerencia
# as portas e o roteamento via Traefik automaticamente.
DB_HOST_PORT=6002
BACKEND_HOST_PORT=6001
FRONTEND_HOST_PORT=6003
