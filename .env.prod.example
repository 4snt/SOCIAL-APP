# ─── Banco de dados ───────────────────────────────────────────────────────────
POSTGRES_DB=socialdb
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha_segura

# ─── Backend ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/socialdb
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Origins permitidas pelo CORS — domínio público de produção
CORS_ALLOWED_ORIGINS=https://social.flipafile.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Proxy interno entre os containers — não alterar
NEXT_PUBLIC_API_URL=http://backend:8080

# ─── Portas expostas no host ──────────────────────────────────────────────────
DB_HOST_PORT=7002
BACKEND_HOST_PORT=7001
FRONTEND_HOST_PORT=7003
